EMBED_PROVIDER=ollama
EMBED_MODEL=embeddinggemma:latest
EMBED_BASE_URL=http://localhost:11434

LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e2b
LLM_BASE_URL=http://localhost:11434

# Ollama generation limits (applied per LLM call)
LLM_TIMEOUT=120        # seconds before httpx gives up on a stalled generation
LLM_NUM_PREDICT=2048   # max tokens Ollama may generate per call

