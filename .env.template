EMBED_PROVIDER=ollama
EMBED_MODEL=embeddinggemma:latest
EMBED_BASE_URL=http://localhost:11434

LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e2b
LLM_BASE_URL=http://localhost:11434

# Ollama generation limits (applied per LLM call)
LLM_TIMEOUT=120        # seconds before httpx gives up on a stalled generation
LLM_NUM_PREDICT=2048   # max tokens Ollama may generate per call

# Anthropic (requires: pip install docquery[anthropic])
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=your-api-key-here

# Azure OpenAI — *_MODEL is the deployment name, not the model name.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-api-key-here
# LLM_PROVIDER=azure
# LLM_MODEL=your-chat-deployment
# LLM_API_VERSION=2024-10-21
# EMBED_PROVIDER=azure
# EMBED_MODEL=your-embedding-deployment
# EMBED_API_VERSION=2024-10-21

# Natural language the source document is written in (informs chat + extraction
# prompts; leave unset for the default behavior).
# DOC_LANGUAGE=German

# Cursor / enumeration tools
CURSOR_SCORE_THRESHOLD=0.6   # min relevance score (0-1) for a chunk to count as a match
CURSOR_MAX_SCAN=2000         # max chunks scored per cursor_count (caps huge docs)

# Structural enumeration: tag chunks at ingest so cursor_enumerate can walk every
# entity of a type. JSON list of {name, pattern}; or use `ingest --entity NAME=REGEX`.
# ENTITY_RULES=[{"name":"instruction","pattern":"^A7\\.7\\.\\d+\\s+([A-Z][A-Z0-9.]+)"}]

# Table-classification rules for structured regions (added to / overriding the
# built-in register_fields, interrupt_table, and pin_map defaults by kind).
# JSON list of {kind, headers, name_column?, entity_type?}; or use
# `ingest --structure KIND=JSON`.
# STRUCTURE_RULES=[{"kind":"dma_table","headers":[["channel"],["request","source"]],"name_column":"channel"}]

# LangSmith tracing (optional — remove or set to false to disable)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=docquery
LANGCHAIN_API_KEY=
