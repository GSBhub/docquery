EMBED_PROVIDER=ollama
EMBED_MODEL=embeddinggemma:latest
EMBED_BASE_URL=http://localhost:11434

LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e2b
LLM_BASE_URL=http://localhost:11434

# Cursor / enumeration tools
CURSOR_SCORE_THRESHOLD=0.6   # min relevance score (0-1) for a chunk to count as a match
CURSOR_MAX_SCAN=2000         # max chunks scored per cursor_count (caps huge docs)

# LangSmith tracing (optional — remove or set to false to disable)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=docquery
LANGCHAIN_API_KEY=
